server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/campus_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
    username: root
    password: 你的数据库密码          # ← 改成你的数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: localhost
      port: 6379
      password:                # ← 有密码就填，没有留空
      database: 0

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

mybatis-plus:
  mapper-locations: classpath:mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT 配置
jwt:
  secret: 随便写一个至少32位的字符串    # ← 改成你自己的密钥
  expiration: 604800000        # 7天 (毫秒)

# 阿里云 OSS 配置
aliyun:
  oss:
    endpoint: oss-cn-xxx.aliyuncs.com    # ← 改成你的地域节点
    access-key-id: 你的AccessKeyId          # ← 改成你的 AK
    access-key-secret: 你的AccessKeySecret  # ← 改成你的 SK
    bucket-name: 你的桶名                  # ← 改成你的桶名
    url-prefix: https://你的桶名.oss-cn-xxx.aliyuncs.com/  # ← 改成你的桶访问域名
